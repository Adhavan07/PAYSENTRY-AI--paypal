{
  "name": "paysentry-ai-paypal-hackathon",
  "version": "1.0.0",
  "description": "Autonomous Multi-Agent Dispute & Chargeback Defense Swarm for PayPal Merchants",
  "main": "start.js",
  "type": "module",
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix client install",
    "dev": "node start.js",
    "start": "node start.js",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "audit": "python3 audit_checks.py"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "keywords": [
    "paypal",
    "hackathon",
    "ai",
    "multi-agent",
    "disputes",
    "chargebacks",
    "ag-grid",
    "fintech"
  ],
  "author": "PaySentry AI Team",
  "license": "MIT"
}
