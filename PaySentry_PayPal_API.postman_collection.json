{
  "info": {
    "_postman_id": "b3e94a82-7d21-4f18-8f83-e028b172a5a1",
    "name": "PaySentry AI - PayPal Disputes & Orders API Collection",
    "description": "Official Postman Collection for PaySentry AI: Autonomous PayPal Dispute & Chargeback Defense Swarm. Contains authenticated endpoints for PayPal Sandbox OAuth2, Disputes API, and Orders v2 API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. PayPal Sandbox OAuth2 Token",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Accept-Language", "value": "en_US" },
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
        ],
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{PAYPAL_CLIENT_ID}}", "type": "string" },
            { "key": "password", "value": "{{PAYPAL_CLIENT_SECRET}}", "type": "string" }
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "grant_type", "value": "client_credentials", "type": "text" }
          ]
        },
        "url": {
          "raw": "https://api-m.sandbox.paypal.com/v1/oauth2/token",
          "protocol": "https",
          "host": ["api-m", "sandbox", "paypal", "com"],
          "path": ["v1", "oauth2", "token"]
        }
      }
    },
    {
      "name": "2. Get Sandbox Customer Disputes",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
        ],
        "url": {
          "raw": "https://api-m.sandbox.paypal.com/v1/customer/disputes",
          "protocol": "https",
          "host": ["api-m", "sandbox", "paypal", "com"],
          "path": ["v1", "customer", "disputes"]
        }
      }
    },
    {
      "name": "3. Provide Evidence to PayPal Dispute",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"evidence_type\": \"PROOF_OF_DELIVERY\",\n  \"evidence_info\": {\n    \"tracking_info\": [\n      {\n        \"carrier_name\": \"UPS\",\n        \"tracking_number\": \"1Z9999999999999999\"\n      }\n    ]\n  },\n  \"notes\": \"Proof of delivery verified via GPS coordinate match. Protected under PayPal Seller Protection Policy §11.2.\"\n}"
        },
        "url": {
          "raw": "https://api-m.sandbox.paypal.com/v1/customer/disputes/{{DISPUTE_ID}}/provide-evidence",
          "protocol": "https",
          "host": ["api-m", "sandbox", "paypal", "com"],
          "path": ["v1", "customer", "disputes", "{{DISPUTE_ID}}", "provide-evidence"]
        }
      }
    },
    {
      "name": "4. Create Sandbox Order (Orders v2)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"intent\": \"CAPTURE\",\n  \"purchase_units\": [\n    {\n      \"amount\": {\n        \"currency_code\": \"USD\",\n        \"value\": \"149.99\"\n      },\n      \"description\": \"PaySentry Protected Merchant Transaction\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "https://api-m.sandbox.paypal.com/v2/checkout/orders",
          "protocol": "https",
          "host": ["api-m", "sandbox", "paypal", "com"],
          "path": ["v2", "checkout", "orders"]
        }
      }
    }
  ]
}
