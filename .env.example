# ====================================================================
# PaySentry AI: Environment Configuration Template
# PayPal AI Hackathon 2026
# Copy this file to .env and insert your sandbox credentials
# ====================================================================

# Port for Backend Server
PORT=5000

# PayPal Sandbox API Credentials (Get these from https://developer.paypal.com)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# PayPal Sandbox Base URL (Pre-configured for sandbox)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI API Keys (Supports Google Gemini or OpenAI for Multi-Agent Forensics)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: OPENAI_API_KEY=your_openai_api_key_here

# Simulation Mode (Set to true to run with high-fidelity realistic sandbox dispute fixtures without API keys)
DEMO_SIMULATION_MODE=true

